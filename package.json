{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @nexus/api dev",
    "dev:client": "pnpm --filter @nexus/client dev",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "export-graph": "tsx scripts/export-graph.ts",
    "backfill-feed": "tsx scripts/backfill-feed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}
