# Copy to .env and fill in values
# cp env.example .env

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus-dev-password

# TypeSafe (Jev / System One)
TYPESAFE_API_KEY=

# API
API_PORT=3001
API_HOST=0.0.0.0
# Required in production: buildApp() fails closed without it
CLIENT_ORIGIN=http://localhost:5173
# Set to your proxy's CIDR (e.g. 10.0.0.0/8) behind Railway/a load balancer —
# without it all proxied clients share one rate-limit identity
TRUST_PROXY=
# Admin endpoint auth (x-api-key header)
API_KEY=

# Client
CLIENT_PORT=5173
# Optional: defaults to the page origin (same-origin /api/ proxy in prod)
VITE_API_URL=

# Twitter/X API
X_BEARER_TOKEN=

# Poll Interval Overrides (optional, ms, minimum 60000)
# Default: 7200000 (2 hours) for all adapters
# POLL_INTERVAL_HACKERNEWS_MS=7200000
# POLL_INTERVAL_ARXIV_MS=7200000
# POLL_INTERVAL_GITHUB_MS=7200000
# POLL_INTERVAL_TWITTER_MS=7200000
