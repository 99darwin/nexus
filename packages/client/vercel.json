{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://api-production-b056d.up.railway.app/api/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-proxy-secret" },
          "args": "$PROXY_SECRET",
          "env": ["PROXY_SECRET"]
        }
      ]
    },
    {
      "src": "^/mcp$",
      "dest": "https://api-production-b056d.up.railway.app/mcp",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": { "key": "x-proxy-secret" },
          "args": "$PROXY_SECRET",
          "env": ["PROXY_SECRET"]
        }
      ]
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
