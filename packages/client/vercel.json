{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-b056d.up.railway.app/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://api-production-b056d.up.railway.app/mcp"
    },
    { "source": "/((?!api/|mcp$).*)", "destination": "/index.html" }
  ]
}
